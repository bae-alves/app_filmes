# Credenciais da API do TMDB (https://www.themoviedb.org/settings/api).
# Copie este arquivo para ".env" e preencha com as suas chaves.
# O ".env" está no .gitignore e nunca deve ser versionado.

# API Read Access Token (v4) - usado no header Authorization: Bearer.
TMDB_READ=

# API Key (v3) - alternativa via query string "api_key".
TMDB_API_KEY=

# Chave da API da Gemini (https://aistudio.google.com/apikey), usada só pelo
# chat de recomendações. Sem ela o app abre, mas o chat mostra erro.
GEMINI_API_KEY=
